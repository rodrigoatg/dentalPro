# Copy this file to .env and set local values before running Docker Compose.
# Keep POSTGRES_PASSWORD equal to the password already used by the existing
# postgres_data volume; changing it here does not change the stored database role.
POSTGRES_DB=dentalpro_dev
POSTGRES_USER=dentalpro
POSTGRES_PASSWORD=REPLACE_WITH_EXISTING_LOCAL_POSTGRES_PASSWORD
POSTGRES_PORT=5432

# Base64-encoded random key containing at least 32 bytes.
JWT_SIGNING_KEY=REPLACE_WITH_A_BASE64_ENCODED_32_BYTE_RANDOM_KEY

# Optional values, required only for the explicit security bootstrap command.
SECURITY_BOOTSTRAP_ADMIN_USERNAME=
SECURITY_BOOTSTRAP_ADMIN_PASSWORD=
SECURITY_BOOTSTRAP_ADMIN_FIRST_NAME=
SECURITY_BOOTSTRAP_ADMIN_LAST_NAME=
SECURITY_BOOTSTRAP_ADMIN_EMAIL=
